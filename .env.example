# Copy to .env next to compose.yaml. .env is gitignored.

# Hostnames this server answers on, comma-separated. Anything else is
# rejected at the MCP endpoint. Must match the tunnel's public hostname.
RIS_PUBLIC_HOSTS=ris-mcp.example.com

# --- Reaching it from the internet: pick one ---

# You already run cloudflared in Docker (compose.external-network.yaml).
# The docker network that connector is attached to:
#   docker inspect <cloudflared-container> \
#     --format '{{range $k, $v := .NetworkSettings.Networks}}{{$k}}{{"\n"}}{{end}}'
CF_NETWORK=

# You want this stack to run its own connector (compose.tunnel.yaml).
# Zero Trust > Networks > Tunnels > create a tunnel > copy the token.
# Treat it as a credential: it is enough to serve traffic for that tunnel.
TUNNEL_TOKEN=

# Concurrent requests in flight to data.bka.gv.at, per process.
RIS_MAX_UPSTREAM=4

# Inbound per-IP token bucket: requests per window (seconds). 0 disables.
RIS_RATE_LIMIT=60
RIS_RATE_WINDOW=60

RIS_LOG_LEVEL=INFO
