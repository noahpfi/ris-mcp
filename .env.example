# copy to .env next to compose.yaml, gitignored

# comma-separated hostnames served, others rejected at /mcp; must match tunnel public hostname
RIS_PUBLIC_HOSTS=ris-mcp.example.com

# cloudflared already in docker -> compose.external-network.yaml, network name via
#   docker inspect <cloudflared-container> --format '{{range $k, $v := .NetworkSettings.Networks}}{{$k}}{{"\n"}}{{end}}'
CF_NETWORK=

# own connector -> compose.tunnel.yaml; token from Zero Trust > Networks > Tunnels = full tunnel credential
TUNNEL_TOKEN=

# max concurrent requests to data.bka.gv.at, per process
RIS_MAX_UPSTREAM=4

# per-IP inbound token bucket, requests per window seconds; 0 disables
RIS_RATE_LIMIT=60
RIS_RATE_WINDOW=60

RIS_LOG_LEVEL=INFO
